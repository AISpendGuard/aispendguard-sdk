{
  "name": "@aispendguard/sdk",
  "version": "0.2.1",
  "description": "Tags-only SDK for tracking AI API spend with AISpendGuard. Supports OpenAI, Anthropic, Google Gemini, LangChain.js, and OpenTelemetry.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mastra": {
      "types": "./dist/mastra.d.ts",
      "default": "./dist/mastra.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "ai",
    "llm",
    "cost",
    "spending",
    "tracking",
    "openai",
    "anthropic",
    "gemini",
    "langchain",
    "mastra",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AISpendGuard/aispendguard-sdk.git"
  },
  "homepage": "https://aispendguard.com",
  "bugs": {
    "url": "https://github.com/AISpendGuard/aispendguard-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run test"
  },
  "peerDependencies": {
    "@mastra/core": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@mastra/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
